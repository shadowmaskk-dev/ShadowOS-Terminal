# Copy this to .env in this same project folder and fill in the keys
# for whichever providers you plan to use. You only need the ones for
# providers you'll actually switch to.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AI...
# Ollama needs no key, just `ollama serve` running locally (or on your LAN).
